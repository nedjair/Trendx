# ============================================================
# Trendx — Image Airflow personnalisée (Apache 2.9.0 Python 3.11)
# IMPORTANT AGENTS §6.2 : PAS D'USAGE DE _PIP_ADDITIONAL_REQUIREMENTS
#            (installation permanente via Dockerfile)
# ============================================================
FROM apache/airflow:2.9.0-python3.11

LABEL org.opencontainers.image.title="Trendx Airflow Scheduler + Web" \
      org.opencontainers.image.description="Apache Airflow 2.9.0 with Trendx ML dependencies" \
      org.opencontainers.image.version="0.1.0"

USER root

# Paquets système minimaux + psycopg2 build deps + OpenBLAS (Prophet)
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential libpq-dev python3-dev \
        libopenblas-dev liblapack-dev gfortran libgomp1 \
        curl dumb-init procps postgresql-client git \
 && rm -rf /var/lib/apt/lists/*

# ——— Constraints épinglées ———
COPY constraints.txt /opt/airflow/constraints.txt
COPY pyproject.toml /opt/airflow/pyproject.toml
COPY ./src /opt/airflow/src

# Installation deps ML + projet trendx (Airflow pip dans venv airflow)
USER airflow
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH="/opt/airflow/src:/opt/airflow/dags:${PYTHONPATH:-}"

RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir \
        --constraint /opt/airflow/constraints.txt \
        "numpy==1.26.4" \
        "pandas==2.2.2" \
        "scipy==1.12.0" \
        "scikit-learn==1.4.2" \
        "statsmodels==0.14.2" \
        "prophet==1.1.5" \
        "pmdarima==2.0.4" \
        "pyod==1.1.3" \
        "numba==0.59.1" \
        "llvmlite==0.42.0" \
        "matplotlib==3.8.4" \
        "psycopg2-binary==2.9.9" \
        "redis==5.0.3" \
        "celery==5.3.6" \
        "httpx==0.27.0" \
        "tenacity==8.2.3" \
        "pendulum==3.0.0" \
        "loguru==0.7.2" \
        "orjson==3.10.1" \
        "pydantic>=2.6" \
        "pydantic-settings>=2.2" \
        "mlflow>=2.12" \
        "python-dotenv>=1.0"

# Downgrade SQLAlchemy to 1.4.52 for Airflow 2.9.0 ORM compat (trendx/api+worker use 2.0.x)
RUN pip install --no-cache-dir "SQLAlchemy==1.4.52" \
 && python -c "import sqlalchemy; print(f'SQLAlchemy {sqlalchemy.__version__} OK')"

# Installer trendx editable src
RUN cd /opt/airflow && pip install --no-deps --no-cache-dir -e . 2>/dev/null || true \
 && python -c "import sys; sys.path.insert(0, '/opt/airflow/src'); import trendx; print('trendx import OK (airflow image)')" 2>/dev/null || true

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["bash", "-c", "airflow version"]
