# ============================================================
# Trendx — API FastAPI + CLI
# Version Python alignée avec Trendz 1.15.0 python-executor (3.11)
# ============================================================
FROM python:3.11.14-slim-bookworm AS base

LABEL org.opencontainers.image.title="Trendx API" \
      org.opencontainers.image.description="Trendx Analytics Platform - Backend API" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://gitea.local/trendx/Trendx" \
      com.trendx.project="trendx"

# ——— Système ———
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_VERSION=1.8.3

# Paquets système essentiels (ssl, tzdata, build outils minimaux, psql client, curl healthcheck)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg lsb-release tzdata locales \
        build-essential libpq-dev python3-dev libopenblas-dev liblapack-dev \
        postgresql-client netcat-openbsd dumb-init procps \
 && rm -rf /var/lib/apt/lists/* \
 && update-ca-certificates \
 && echo "UTC" > /etc/timezone && dpkg-reconfigure -f noninteractive tzdata

# ——— Emplacement projet ———
ENV APP_HOME=/app
WORKDIR $APP_HOME

# ——— Dépendances Python (épinglées via constraints.txt) ———
COPY constraints.txt ./constraints.txt
COPY pyproject.toml ./pyproject.toml
# MAJ pip/wheel, setuptools <68 (pkg_resources needed by mlflow removed in 68+)
RUN python3 -m pip install --upgrade pip wheel \
 && python3 -m pip install --no-cache-dir "setuptools>=65,<68" \
 && python3 -m pip install --no-cache-dir -c constraints.txt \
        "fastapi>=0.110" \
        "uvicorn>=0.29" \
        "sqlalchemy>=2.0" \
        "alembic>=1.13" \
        "psycopg2-binary>=2.9" \
        "psycopg>=3.1" \
        "redis>=5.0" \
        "celery>=5.3" \
        "pydantic>=2.6" \
        "pydantic-settings>=2.2" \
        "python-dotenv>=1.0" \
        "httpx>=0.27" \
        "loguru>=0.7" \
        "pendulum>=3.0" \
        "tenacity>=8.2" \
        "pandas>=2.2" \
        "numpy<2" \
        "scipy>=1.12" \
        "scikit-learn>=1.4" \
        "statsmodels>=0.14" \
        "prophet>=1.1" \
        "pmdarima>=2.0" \
        "pyod>=1.1" \
        "mlflow>=2.12" \
        "matplotlib>=3.8" \
        "orjson>=3.9" \
 && python3 -m pip install --no-cache-dir \
        "uvicorn[standard]" \
        "psycopg[binary]"

# ——— Code projet (monté en volume local, COPY ici pour image autonome) ———
COPY ./src $APP_HOME/src
COPY ./migrations $APP_HOME/migrations
COPY ./scripts $APP_HOME/scripts
COPY ./tests $APP_HOME/tests

# Installer trendx en mode editable (depuis pyproject.toml src layout)
RUN python3 -m pip install --no-cache-dir --no-deps -c constraints.txt -e . \
 && python3 -c "import trendx; print('trendx import OK:', trendx.__name__ if hasattr(trendx,'__name__') else 'OK')" 2>/dev/null || true

# ——— Exposition ———
EXPOSE 8000

# ——— Startup sain (dumb-init évite pid 1 zombies) ———
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["uvicorn", "trendx.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
