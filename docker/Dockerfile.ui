# ============================================================
# Trendx — UI React/Vite buildée + servie par nginx alpine
# Équivalent conteneur thingsboard-trendz:1.15.0 UI servlet Java
# Ports interne nginx :80 → hôte TRENDX_UI_HOST_PORT=8080
# ============================================================

# ——— STAGE 1 : Builder React + TypeScript + Vite ———
FROM node:20.13.1-bookworm-slim AS builder

# pipefail : les RUN avec pipe (npm … | tail) doivent échouer si npm échoue
# (sans pipefail, tail masque l'échec du build).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL org.opencontainers.image.title="Trendx UI Builder"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates=20250419~deb12u1 curl=7.88.1-10+deb12u15 git=1:2.39.5-0+deb12u3 \
        python3=3.11.2-1+b1 make=4.3-4.1 g++=4:12.2.0-3 tzdata=2026b-0+deb12u1 \
 && rm -rf /var/lib/apt/lists/* \
 && echo "UTC" > /etc/timezone && dpkg-reconfigure -f noninteractive tzdata

WORKDIR /build

# ——— Package JSON minimales (Vite + React 18 + TS + ECharts 21 types visuels) ———
RUN mkdir -p /build/ui
WORKDIR /build/ui
COPY ui/package.json ui/package-lock.json*  ./

RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund --ignore-scripts 2>&1 || \
    (rm -rf node_modules package-lock.json && \
     npm install --no-audit --no-fund 2>&1 | tail -30)

# Argument API backend
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Copie source UI (si absente, skeleton : index.html + main.tsx)
COPY ui/ ./

# Write stub HTML first; then conditionally build over it
RUN mkdir -p dist && cat > dist/index.html <<'STUB_HTML'
<!doctype html><html lang="en"><head><meta charset="utf-8"/><title>Trendx Analytics - Build Skeleton</title>
<meta name="viewport" content="width=device-width,initial-scale=1"/><style>
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0f172a;color:#e2e8f0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.card{padding:2rem 2.5rem;border-radius:1rem;background:#1e293b;border:1px solid #334155;box-shadow:0 10px 30px #00000050;max-width:520px}
h1{margin:0 0 .5rem;font-size:1.6rem;color:#38bdf8}p{margin:.5rem 0;line-height:1.5;color:#cbd5e1}
.badge{display:inline-block;padding:.15rem .6rem;border-radius:999px;background:#14532d;color:#86efac;font-size:.75rem;font-weight:600;margin-right:.5rem}
hr{opacity:.2;border-color:#475569}
ul{padding-left:1.25rem;margin-top:.25rem}
li{margin:.25rem 0;color:#cbd5e1}
footer{margin-top:1rem;padding-top:1rem;border-top:1px dashed #475569;font-size:.8rem;color:#94a3b8}
</style></head><body><main class="card">
<h1>Trendx Analytics Platform</h1>
<div><span class="badge">MVP</span><span class="badge">Phase 2</span><span class="badge">UI Skeleton</span></div>
<p>La stack Trendx est en place. Les composants UI React + Vite + ECharts seront ajoutés en Phase 3+4.</p>
<hr/>
<h3 style="margin:1rem 0 .5rem;color:#facc15">Stack operationnelle :</h3>
<ul>
<li>API FastAPI backend : <code>http://localhost:8000</code> (<a href="/health" style="color:#38bdf8">/health</a>)</li>
<li>Orchestrateur Airflow : <a href="http://localhost:8082" style="color:#38bdf8">http://localhost:8082</a></li>
<li>Tracking modeles MLflow : <a href="http://localhost:5000" style="color:#38bdf8">http://localhost:5000</a></li>
<li>Observabilite Grafana : <a href="http://localhost:3001" style="color:#38bdf8">http://localhost:3001</a></li>
<li>Python Worker (Prophet, ARIMA, PyOD) : Celery + Redis</li>
<li>PostgreSQL 16 + TimescaleDB : hypertables, CAGGs, compression, retention</li>
</ul>
<footer>Writeback et alarmes desactives en Phase 2.</footer>
</main></body></html>
STUB_HTML

# If Vite config present, override stub with real build
RUN if [ -f vite.config.ts ] || [ -f vite.config.js ]; then \
        rm -rf dist && npm run build 2>&1 | tail -30 ; \
    fi

# ——— STAGE 2 : Runtime nginx alpine ———
FROM nginx:1.27.0-alpine-slim AS runtime

LABEL org.opencontainers.image.title="Trendx UI Runtime" \
      org.opencontainers.image.description="Nginx serving Trendx React/Vite SPA with API proxy" \
      org.opencontainers.image.version="0.1.0" \
      com.trendx.project="trendx"

# config nginx : SPA fallback index.html + /api/* proxy vers api:8000
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf

# Assets build
COPY --from=builder /build/ui/dist /usr/share/nginx/html

# healthcheck via wget alpine (versions observées le 2026-09-08 dans nginx:1.27.0-alpine-slim, Alpine v3.19).
RUN apk add --no-cache wget=1.21.4-r0 tzdata=2024a-r0 ca-certificates=20250911-r0 dumb-init=1.2.5-r3 \
  && ln -sf /usr/share/zoneinfo/UTC /etc/localtime

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=6 \
  CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8443/healthz"]

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
# hadolint ignore=DL3025 -- "daemon off;" DOIT rester un argument unique (directive -g de nginx) ; le découper casserait le démarrage.
CMD ["nginx", "-g", "daemon off;"]
