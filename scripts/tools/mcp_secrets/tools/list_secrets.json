{
  "name": "list_secrets",
  "description": "Lister les chemins de secrets dans un moteur de secrets (Vault, KMS, etc.)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Chemin de base dans le moteur de secrets",
        "default": "/"
      },
      "engine": {
        "type": "string",
        "description": "Nom/identifiant du moteur de secrets",
        "default": "kv"
      },
      "recursive": {
        "type": "boolean",
        "description": "Lister récursivement",
        "default": false
      }
    },
    "required": []
  }
}
