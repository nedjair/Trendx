# ============================================================
# Trendx — Fichier de variables exemple (VALEURS FACTICES)
# Jamais commiter le .env réel. Permissions : chmod 600 .env
# Secrets dans /opt/trendx/.secrets/ (dir 700, fichiers 600, root)
# ============================================================

# ============================================================
# Environnement Trendx
# ============================================================
TRENDX_ENV=development
TRENDX_LOG_LEVEL=INFO
TRENDX_TIMEZONE=UTC
TRENDX_PROFILE=minimal
TRENDX_HOST=10.0.0.1
TRENDX_HOSTNAME=trendx

# Identifiants ThingsBoard par défaut pour la création de tâches Trendx.
# Récupérer depuis l'API ThingsBoard (GET /api/tenant) ou le dashboard TB.
TRENDX_DEFAULT_TENANT_ID=
TRENDX_DEFAULT_CUSTOMER_ID=
TRENDX_DEFAULT_USER_ID=
# W101 : chemin du datastore JSON durable existant. Vide = API fail-closed.
TRENDX_EXECUTION_HISTORY_PATH=
# W109 : racine d'archives W107 contrôlée côté serveur. Vide = API recovery fail-closed.
# Le client HTTP ne fournit jamais un chemin d'archive.
TRENDX_EXECUTION_ARCHIVE_PATH=

# ============================================================
# Canal 1 : ThingsBoard API REST (topologie, writeback, alarms)
# ============================================================
# Depuis l'hôte : http://10.0.0.1:8081
# Depuis le réseau Docker Trendx : http://thingsboard_thingsboard-ce_1:8080
TB_BASE_URL=https://10.0.0.1:8081/
TB_USERNAME=tenant@mobilis.dz
TB_PASSWORD=CHANGE_ME
TB_REQUEST_TIMEOUT_SECONDS=30
TB_RETRY_MAX_ATTEMPTS=5
TB_RETRY_BACKOFF_SECONDS=2
# JWT auto-renew, pagination 100 items par défaut, fenêtre recouvrement 1h ingestion
TB_JWT_LEEWAY_SECONDS=300
TB_PAGE_SIZE=100
TB_INGEST_RECOVERY_WINDOW_HOURS=1
# TB_AUTH_CONFIGURED=true uniquement quand un compte service ThingsBoard vérifié
# est en place (.secrets/service-accounts.env). Verrou d'ingestion : absent => false.
TB_AUTH_CONFIGURED=false

# ============================================================
# Writeback ThingsBoard — B3 : AUTORISÉ SOUS CONDITIONS
# TB_WRITEBACK_ENABLED=false par défaut. Activation explicite requise.
# Writeback par API ThingsBoard uniquement, jamais par SQL direct.
# Allowlist stricte : un seul device test, une seule métrique, horizon court.
# Préfixe obligatoire _EPD_ pour prévisions, _ECD_ pour champs calculés.
# Journal des clés écrites + procédure de suppression documentée requise.
# ============================================================
TB_WRITEBACK_ENABLED=false
TB_WRITEBACK_KEY_PREFIX_EPD=_EPD_
TB_WRITEBACK_KEY_PREFIX_ECD=_ECD_
TB_WRITEBACK_DEVICE_ALLOWLIST=ALG16025001
TB_WRITEBACK_METRIC_ALLOWLIST=mppt_main_battery_voltage_v
TB_WRITEBACK_LOG_FILE=/var/log/trendx/writeback.log
TB_ALARMS_ENABLED=false

# ============================================================
# Canal 2 : PostgreSQL ThingsBoard READ-ONLY (haute performance)
# Connexion par le réseau Docker existant mobili_dahsboard_default,
# nom du conteneur PostgreSQL TB, port interne 5432.
# B2 : REFUSÉ exposition/tunnel. Ne pas utiliser 5433 hôte.
# B1 : APPROUVÉ rôle trendx_ro (CONNECT+USAGE+SELECT, RON, timeout).
# ============================================================
TB_DB_HOST=mobili_dahsboard-postgres-1
TB_DB_PORT=5432
TB_DB_NAME=thingsboard
TB_DB_READONLY_USER=trendx_ro
TB_DB_READONLY_PASSWORD=CHANGE_ME_IF_CREATED
TB_DB_SSLMODE=prefer
TB_DB_CONNECT_TIMEOUT=5
TB_DB_STATEMENT_TIMEOUT=60000
TB_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30000
TB_DB_CONNECTION_LIMIT=5
TB_DB_USE_NATIVE_DICTIONARY=true

# ============================================================
# Bases Trendx — UNE SEULE BASE trendx avec schémas (Correction A)
# ============================================================
# Base unique : trendx
# Schémas : trendx_catalog (métadonnées, modèles), trendx_analytics (ts_kv, prédictions, anomalies)
# Pas de trendx_airflow ni trendx_mlflow en Phase 2
TRENDX_DB_HOST=mobili_dahsboard-postgres-1
TRENDX_DB_PORT=5432
TRENDX_DB_NAME=trendx
TRENDX_DB_USER=trendx_app
TRENDX_DB_PASSWORD=CHANGE_ME
TRENDX_DB_SSLMODE=prefer
TRENDX_DB_CONNECT_TIMEOUT=5
TRENDX_DB_STATEMENT_TIMEOUT=60000
TRENDX_DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=30000
TRENDX_DB_POOL_SIZE=10

# ============================================================
# PostgreSQL : comptes dédiés moindre privilège
# ============================================================
PG_ADMIN_HOST=mobili_dahsboard-postgres-1
PG_ADMIN_PORT=5432
PG_ADMIN_DB=postgres
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=CHANGE_ME

# TimescaleDB : désactivé par défaut (nécessite approbation AGENTS.md)
TRENDX_TIMESCALEDB_ENABLED=false

# ============================================================
# Secrets et identifiants (stockés dans /opt/trendx/.secrets/)
# ============================================================
TRENDX_CREDENTIALS_FILE=/opt/trendx/.secrets/service-accounts.env
TRENDX_MIGRATION_USER=trendx_migration
TRENDX_MIGRATION_PASSWORD=CHANGE_ME
TRENDX_APP_USER=trendx_app
TRENDX_APP_PASSWORD=CHANGE_ME
TRENDX_JWT_SIGNING_KEY=CHANGE_ME
# W109 restore refuse fail-closed tant que ce jeton reste un placeholder.
TRENDX_API_TOKEN=CHANGE_ME

# ============================================================
# Pare-feu : actions destructives nécessitent TRENDX_CONFIRM_APPLY=YES
# ============================================================
TRENDX_CONFIRM_APPLY=NO

# ============================================================
# Rétention et disque
# ============================================================
TRENDX_RETENTION_DAYS=180
TRENDX_DISK_MIN_FREE_GB=50
# Verrou d'ingestion : false par défaut. L'endpoint /api/v1/ingestion/trigger
# refuse (409) tant que TRENDX_INGEST_ENABLED n'est pas explicitement true.
TRENDX_INGEST_ENABLED=false
TRENDX_DISK_MONITOR_MOUNTS=/opt/trendx/data
TRENDX_DISK_WARNING_GB=100
TRENDX_DISK_ALERT_GB=200

# ============================================================
# Agrégats (Q3 — VALIDÉ)
# ============================================================
AGGREGATION_HOURLY_INTERVAL_MINUTES=15
AGGREGATION_HOURLY_LOOKBACK_HOURS=3
AGGREGATION_DAILY_INTERVAL_HOURS=1
AGGREGATION_DAILY_LOOKBACK_DAYS=2
AGGREGATION_WEEKLY_MONTHLY_SCHEDULE=0 2 * * *  # 2h hors pointe

# ============================================================
# Planificateur — APScheduler (Correction C)
# ============================================================
TRENDX_SCHEDULER=apscheduler
TRENDX_SCHEDULER_STORAGE=trendx_catalog.trendz_task

# MR-5 déduplication ingestion : true = comportement historique (le worker
# planifie ingestion_hourly). Passer à false quand le profil scheduler B1
# est actif (un seul planificateur — contrat XOR worker/scheduler).
# Rollback : true + restart worker.
TRENDX_WORKER_INGESTION_ENABLED=true

# ============================================================
# Scheduler B1 — leader election / heartbeat (MR-3)
# Tout est DÉSACTIVÉ par défaut : TRENDX_SCHEDULER_ENABLED=false interdit
# toute planification. Validation fail-closed dans LeaderElection
# (entiers > 0, STALE > HEARTBEAT, lock/instance non vides).
# ============================================================
TRENDX_SCHEDULER_ENABLED=false
TRENDX_SCHEDULER_INSTANCE_ID=
# Forecast B1 jamais fonctionnel (pas de fan-out par device) : false par défaut
# = forecast-train/forecast-run non planifiés ; ingestion/discovery inchangés.
TRENDX_SCHEDULER_FORECAST_ENABLED=false
TRENDX_SCHEDULER_HEARTBEAT_SECONDS=15
TRENDX_SCHEDULER_STALE_SECONDS=60
TRENDX_SCHEDULER_ACQUIRE_TIMEOUT_SECONDS=5
TRENDX_SCHEDULER_LEADER_LOCK=trendx_scheduler_leader

# ============================================================
# Services internes Trendx — B6 : AUCUN port ouvert sur l'hôte.
# Un seul point d'entrée : reverse-proxy Trendx TLS 8443 sur 127.0.0.1.
# ============================================================
TRENDX_API_HOST=0.0.0.0
TRENDX_API_PORT=8000
TRENDX_WORKERS=2
TRENDX_WORKER_HEALTH_PORT=8181
TRENDX_REVERSE_PROXY_PORT=8443
TRENDX_REVERSE_PROXY_BIND=127.0.0.1

# ============================================================
# Prévision
# ============================================================
FORECAST_FREQUENCY=1h
FORECAST_HORIZON=24
TRAINING_LOOKBACK_DAYS=90
# Exclusion Train des batchs synthétiques (vide = aucune exclusion).
# Voir docs/train-synthetic-exclusion.md pour la liste des 11 ingestion_id
# de septembre 2026 et la procédure de remplacement.
TRAINING_EXCLUDED_INGESTION_IDS=
FORECAST_MIN_VALUE=0
FORECAST_MAX_VALUE=60
FORECAST_OUTPUT_PREFIX_EPD=_EPD_

# ============================================================
# Détection d'anomalies
# ============================================================
ANOMALY_DETECTION_ENABLED=false
ANOMALY_CONTAMINATION=0.01
ANOMALY_WINDOW_SIZE=24
ANOMALY_ALARM_COOLDOWN_HOURS=2
ANOMALY_ALARM_HYSTERESIS_RATIO=0.75

# ============================================================
# Services API & UI Trendx
# ============================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================
# MCP : Vision (analyse d'images)
# ============================================================
# Clé API Google pour le serveur MCP ai-vision-mcp
# Obtenir une clé : https://aistudio.google.com/apikey
# GOOGLE_API_KEY=CHANGE_ME
