from __future__ import annotations

import uuid
from datetime import datetime
from typing import Any, Optional

from sqlalchemy import (
    BigInteger,
    Boolean,
    Computed,
    Double,
    Float,
    ForeignKey,
    Integer,
    LargeBinary,
    PrimaryKeyConstraint,
    Text,
    UniqueConstraint,
)
from sqlalchemy.dialects.postgresql import JSONB, UUID, INET
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column, relationship
from sqlalchemy.sql import func


class Base(DeclarativeBase):
    pass


# ── LOT 1/4: Business entities & topology ──────────────────────────────


class BusinessEntity(Base):
    __tablename__ = "business_entity"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False)
    type: Mapped[str] = mapped_column(Text, nullable=False, default="DEVICE")
    entity_id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), nullable=False)
    source: Mapped[str] = mapped_column(Text, nullable=False, default="thingsboard")
    additional_info: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    search_text: Mapped[str] = mapped_column(
        Text,
        Computed("lower(coalesce(name, '') || ' ' || coalesce(type, ''))"),
        nullable=True,
    )
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    updated_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("source", "entity_id", "type", name="ux_business_entity_source"),
    )

    relations_from: Mapped[list[EntityRelation]] = relationship(
        foreign_keys="EntityRelation.from_id", back_populates="from_entity"
    )
    relations_to: Mapped[list[EntityRelation]] = relationship(
        foreign_keys="EntityRelation.to_id", back_populates="to_entity"
    )


class EntityRelation(Base):
    __tablename__ = "entity_relation"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True)
    from_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    to_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    relation_type: Mapped[str] = mapped_column(Text, nullable=False, default="Contains")
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("from_id", "to_id", "relation_type", name="ux_entity_relation_pair"),
    )

    from_entity: Mapped[BusinessEntity] = relationship(
        foreign_keys=[from_id], back_populates="relations_from"
    )
    to_entity: Mapped[BusinessEntity] = relationship(
        foreign_keys=[to_id], back_populates="relations_to"
    )


class EntityGroup(Base):
    __tablename__ = "entity_group"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False)
    owner_type: Mapped[str] = mapped_column(Text, nullable=False)
    owner_id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), nullable=False)
    additional_info: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    updated_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("owner_type", "owner_id", "name", name="ux_entity_group_owner"),
    )

    members: Mapped[list[EntityGroupMember]] = relationship(back_populates="group")


class EntityGroupMember(Base):
    __tablename__ = "entity_group_member"

    group_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("entity_group.id", ondelete="CASCADE"), primary_key=True
    )
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), primary_key=True
    )
    added_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    group: Mapped[EntityGroup] = relationship(back_populates="members")


class ClusterInfo(Base):
    __tablename__ = "cluster_info"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False, unique=True)
    owner_entity_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="SET NULL"), nullable=True
    )
    algorithm: Mapped[str] = mapped_column(Text, nullable=False, default="kmeans")
    parameters: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    metrics: Mapped[list[Any]] = mapped_column(JSONB, nullable=False, default=list)
    computed_at: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())


class ClusterMember(Base):
    __tablename__ = "cluster_member"

    cluster_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("cluster_info.id", ondelete="CASCADE"), primary_key=True
    )
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), primary_key=True
    )
    cluster_label: Mapped[int] = mapped_column(Integer, nullable=False, default=0)
    distance_to_centroid: Mapped[Optional[float]] = mapped_column(Float, nullable=True)
    assigned_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())


# ── LOT 2/4: Metrics, calculated fields, data sources ─────────────────


class MetricDefinition(Base):
    __tablename__ = "metric_definition"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False)
    key: Mapped[str] = mapped_column(Text, nullable=False)
    entity_type: Mapped[str] = mapped_column(Text, nullable=False, default="DEVICE")
    data_type: Mapped[str] = mapped_column(Text, nullable=False, default="DOUBLE")
    unit: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    min_value: Mapped[Optional[float]] = mapped_column(Float, nullable=True)
    max_value: Mapped[Optional[float]] = mapped_column(Float, nullable=True)
    description: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    source: Mapped[str] = mapped_column(Text, nullable=False, default="thingsboard")
    is_active: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    updated_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("key", "entity_type", "source", name="ux_metric_definition"),
    )


class CalculatedField(Base):
    __tablename__ = "calculated_field"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False)
    entity_type: Mapped[str] = mapped_column(Text, nullable=False, default="DEVICE")
    output_data_type: Mapped[str] = mapped_column(Text, nullable=False, default="DOUBLE")
    script_language: Mapped[str] = mapped_column(Text, nullable=False, default="python")
    script_source: Mapped[str] = mapped_column(Text, nullable=False)
    dependencies: Mapped[list[Any]] = mapped_column(JSONB, nullable=False, default=list)
    timeout_ms: Mapped[int] = mapped_column(Integer, nullable=False, default=10000)
    version: Mapped[int] = mapped_column(Integer, nullable=False, default=1)
    is_draft: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)
    owner_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="SET NULL"), nullable=True
    )
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    updated_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("name", "entity_type", "version", name="ux_calculated_field"),
    )


class CalculatedFieldExecution(Base):
    __tablename__ = "calculated_field_execution"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True)
    field_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("calculated_field.id", ondelete="CASCADE"), nullable=False
    )
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    period_start: Mapped[datetime] = mapped_column(nullable=False)
    period_end: Mapped[datetime] = mapped_column(nullable=False)
    status: Mapped[str] = mapped_column(Text, nullable=False)
    started_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    finished_at: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    duration_ms: Mapped[Optional[int]] = mapped_column(Integer, nullable=True)
    error_message: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    rows_processed: Mapped[Optional[int]] = mapped_column(Integer, nullable=True)
    script_version: Mapped[int] = mapped_column(Integer, nullable=False, default=1)


class MetricBinding(Base):
    __tablename__ = "metric_binding"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True)
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    metric_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("metric_definition.id", ondelete="CASCADE"), nullable=False
    )
    aggregation: Mapped[str] = mapped_column(Text, nullable=False, default="avg")
    is_default: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())

    __table_args__ = (
        UniqueConstraint("entity_id", "metric_id", "aggregation", name="ux_metric_binding"),
    )


class DataSource(Base):
    __tablename__ = "data_source"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False, unique=True)
    type: Mapped[str] = mapped_column(Text, nullable=False, default="timescaledb")
    connection_config: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    is_default: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False)
    is_active: Mapped[bool] = mapped_column(Boolean, nullable=False, default=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())


# ── LOT 3/4: Predictions, anomalies, tasks, alerts, writeback ─────────


class PredictionModel(Base):
    __tablename__ = "prediction_model"

    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    name: Mapped[str] = mapped_column(Text, nullable=False)
    entity_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="SET NULL"), nullable=True
    )
    metric_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("metric_definition.id", ondelete="SET NULL"), nullable=True
    )
    metric_key: Mapped[str] = mapped_column(Text, nullable=False)
    algorithm: Mapped[str] = mapped_column(Text, nullable=False, default="Prophet")
    hyperparameters: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    frequency: Mapped[str] = mapped_column(Text, nullable=False, default="1h")
    horizon: Mapped[int] = mapped_column(Integer, nullable=False, default=24)
    lookback_days: Mapped[int] = mapped_column(Integer, nullable=False, default=90)
    scaler: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    train_metrics: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    test_metrics: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    train_period_start: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    train_period_end: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    data_version: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    mlflow_run_id: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    mlflow_model_uri: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    status: Mapped[str] = mapped_column(Text, nullable=False, default="draft")
    is_champion: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False)
    champion_since: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    previous_champion_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("prediction_model.id", ondelete="SET NULL"), nullable=True
    )
    code_version: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    artifact_path: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    trained_at: Mapped[Optional[datetime]] = mapped_column(nullable=True)


class PredictionRun(Base):
    __tablename__ = "prediction_run"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True)
    model_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("prediction_model.id", ondelete="CASCADE"), nullable=False
    )
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    metric_key: Mapped[str] = mapped_column(Text, nullable=False)
    forecast_timestamp: Mapped[datetime] = mapped_column(nullable=False)
