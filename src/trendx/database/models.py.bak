    contamination: Mapped[float] = mapped_column(Double, nullable=False, default=0.01)
    window_size: Mapped[int] = mapped_column(Integer, nullable=False, default=24)
    features: Mapped[list[Any]] = mapped_column(JSONB, nullable=False, default=list)
    parameters: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)
    threshold: Mapped[Optional[float]] = mapped_column(Float, nullable=True)
    status: Mapped[str] = mapped_column(Text, nullable=False, default="draft")
    trained_at: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    mlflow_run_id: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    artifact_path: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())


class Anomaly(Base):
    __tablename__ = "anomaly"

    id: Mapped[int] = mapped_column(BigInteger, primary_key=True)
    detector_id: Mapped[Optional[uuid.UUID]] = mapped_column(
        UUID(as_uuid=True), ForeignKey("anomaly_detector.id", ondelete="SET NULL"), nullable=True
    )
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), nullable=False
    )
    metric_key: Mapped[str] = mapped_column(Text, nullable=False)
    anomaly_type: Mapped[str] = mapped_column(Text, nullable=False, default="point")
    severity: Mapped[str] = mapped_column(Text, nullable=False, default="LOW")
    score: Mapped[float] = mapped_column(Double, nullable=False, default=0.0)
    anomaly_score_index: Mapped[Optional[float]] = mapped_column(Float, nullable=True)
    start_ts: Mapped[datetime] = mapped_column(nullable=False)
    end_ts: Mapped[datetime] = mapped_column(nullable=False)
    duration_seconds: Mapped[Optional[int]] = mapped_column(Integer, nullable=True)
    episode_id: Mapped[Optional[int]] = mapped_column(BigInteger, nullable=True)
    is_resolved: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False)
    resolved_at: Mapped[Optional[datetime]] = mapped_column(nullable=True)
    created_at: Mapped[datetime] = mapped_column(nullable=False, server_default=func.now())
    additional_info: Mapped[dict[str, Any]] = mapped_column(JSONB, nullable=False, default=dict)


class AnomalyScore(Base):
    __tablename__ = "anomaly_score"

    ts: Mapped[datetime] = mapped_column(nullable=False, primary_key=True)
    entity_id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), ForeignKey("business_entity.id", ondelete="CASCADE"), primary_key=True
    )
