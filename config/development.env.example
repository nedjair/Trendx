# ========================================
# Environnement Développement
# ========================================

# Application
APP_NAME=Trendx
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trendx_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Keys / Services
API_KEY=your_dev_api_key_here
SECRET_KEY=your_dev_secret_key_here

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/development.log
