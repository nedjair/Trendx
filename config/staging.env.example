# ========================================
# Environnement Staging
# ========================================

# Application
APP_NAME=Trendx
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.trendx.com
APP_PORT=3000

# Base de données
DB_HOST=staging-db.trendx.internal
DB_PORT=5432
DB_NAME=trendx_staging
DB_USER=trendx_staging_user
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=staging-redis.trendx.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# API Keys / Services
API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME

# Logging
LOG_LEVEL=info
LOG_FILE=logs/staging.log
