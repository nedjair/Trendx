# ========================================
# Environnement Production
# ========================================

# Application
APP_NAME=Trendx
APP_ENV=production
APP_DEBUG=false
APP_URL=https://trendx.com
APP_PORT=3000

# Base de données
DB_HOST=prod-db.trendx.internal
DB_PORT=5432
DB_NAME=trendx_prod
DB_USER=trendx_prod_user
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=prod-redis.trendx.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# API Keys / Services
API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME

# Logging
LOG_LEVEL=warn
LOG_FILE=logs/production.log
