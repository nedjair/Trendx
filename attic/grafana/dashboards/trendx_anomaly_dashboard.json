          "rawSql": "SELECT\n  ts AS time,\n  CASE WHEN is_anomaly THEN 1 ELSE 0 END AS value\nFROM anomaly_score\nWHERE entity_id = '${device_id}'::uuid\n  AND metric_key = '${metric_name}'\n  AND ts >= ${__from:date}\n  AND ts < ${__to:date}\nORDER BY ts",
