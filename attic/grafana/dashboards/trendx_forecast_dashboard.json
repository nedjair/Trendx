          "format": "table",
          "group": [],
          "hide": false,
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH actual_forecast AS (\n  SELECT\n    kv.ts,\n    kv.dbl_v AS actual,\n    fs.value AS predicted\n  FROM ts_kv kv\n  JOIN forecast_series fs\n    ON kv.entity_id = fs.entity_id\n    AND kv.metric_key = fs.metric_key\n    AND kv.ts = fs.ts\n  WHERE kv.entity_id = '${device_id}'::uuid\n    AND kv.metric_key = '${metric_name}'\n    AND kv.ts >= ${__from:date}\n    AND kv.ts < ${__to:date}\n    AND (fs.model_used = '${algorithm}' OR '${algorithm}' = 'All')\n)\nSELECT (actual - predicted) AS value\nFROM actual_forecast\nWHERE actual IS NOT NULL AND predicted IS NOT NULL",
          "refId": "A",
          "select": [[{ "params": ["value"], "type": "column" }]],
          "timeColumn": "time",
          "where": []
        }
      ],
      "title": "Error Distribution (forecast errors)",
      "type": "histogram"
    },
