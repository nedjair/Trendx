      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "trendx-timescaledb" },
          "format": "table",
          "group": [],
          "hide": false,
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH\n  expected AS (\n    SELECT COUNT(*) AS cnt FROM generate_series(\n      date_trunc('hour', ${__from:date}),\n      date_trunc('hour', ${__to:date}),\n      interval '1 hour'\n    ) AS gs\n  ),\n  actual AS (\n    SELECT COUNT(DISTINCT date_trunc('hour', ts)) AS cnt\n    FROM ts_kv\n    WHERE entity_id = '${device_id}'::uuid\n      AND metric_key = '${metric_name}'\n      AND ts >= ${__from:date}\n      AND ts < ${__to:date}\n  )\nSELECT\n  CASE WHEN expected.cnt > 0\n    THEN ROUND((actual.cnt::numeric / expected.cnt) * 100, 1)\n    ELSE 0\n  END AS value\nFROM expected, actual",
          "refId": "A",
          "select": [[{ "params": ["value"], "type": "column" }]],
          "timeColumn": "time",
          "where": []
        }
      ],
      "title": "Data Completeness %",
      "type": "gauge"
    },
    {
