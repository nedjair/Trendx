          "format": "time_series",
          "group": [],
          "hide": false,
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT date_trunc('hour', gs) AS hour\n  FROM generate_series(\n    date_trunc('hour', ${__from:date}),\n    date_trunc('hour', ${__to:date}),\n    interval '1 hour'\n  ) AS gs\n)\nSELECT\n  h.hour AS time,\n  COUNT(kv.ts) AS value\nFROM hours h\nLEFT JOIN ts_kv kv\n  ON date_trunc('hour', kv.ts) = h.hour\n  AND kv.entity_id = '${device_id}'::uuid\n  AND kv.metric_key = '${metric_name}'\nGROUP BY h.hour\nORDER BY h.hour",
          "refId": "A",
          "select": [[{ "params": ["value"], "type": "column" }]],
          "timeColumn": "time",
          "where": []
        }
      ],
