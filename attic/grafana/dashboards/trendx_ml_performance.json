        "content": "-- Feature Importance (supports feature_definition table)\nSELECT\n  name,\n  feature_family,\n  algorithm_scope,\n  window_size,\n  aggregation,\n  is_active,\n  feature_version\nFROM feature_definition\nWHERE algorithm_scope = '${algorithm}' OR algorithm_scope = 'ALL'\nORDER BY name;\n\n-- Top features from prediction_model (when available)\nSELECT\n  id,\n  name,\n  algorithm,\n  test_metrics->>'smape' AS smape,\n  mlflow_run_id\nFROM prediction_model\nWHERE algorithm = '${algorithm}'\n  AND ('${model_name}' = 'All' OR name = '${model_name}')\nORDER BY trained_at DESC\nLIMIT 20;\n",
