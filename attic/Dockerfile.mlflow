# ============================================================
# Trendx — MLflow Tracking Server + Model Registry
# Python 3.11 slim + psycopg2 + Timescale connexion OK
# ============================================================
FROM python:3.11.14-slim-bookworm

LABEL org.opencontainers.image.title="Trendx MLflow Server" \
      org.opencontainers.image.description="MLflow 2.14 tracking + registry - PostgreSQL backend" \
      org.opencontainers.image.version="0.1.0"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLFLOW_HOME=/mlflow \
    MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates=20250419~deb12u1 curl=7.88.1-10+deb12u15 tzdata=2026b-0+deb12u1 \
        build-essential=12.9 libpq-dev=15.19-0+deb12u1 python3-dev=3.11.2-1+b1 \
        dumb-init=1.2.5-2 procps=2:4.0.2-3 postgresql-client=15+248+deb12u1 git=1:2.39.5-0+deb12u3 \
 && rm -rf /var/lib/apt/lists/* \
 && echo "UTC" > /etc/timezone && dpkg-reconfigure -f noninteractive tzdata

COPY constraints.txt /tmp/constraints.txt

# MLflow + PostgreSQL + stockage artifacts
# setuptools <72.0 retains pkg_resources required by mlflow.utils.requirements_utils
# -c constraints.txt : setuptools borné par setuptools<81 (compatible ==71.0.4).
RUN python3 -m pip install --upgrade -c /tmp/constraints.txt pip wheel \
 && python3 -m pip install --no-cache-dir -c /tmp/constraints.txt \
        setuptools==71.0.4 \
        mlflow==2.14.3 \
        psycopg2-binary==2.9.9 \
        SQLAlchemy==2.0.29 \
        alembic==1.13.1 \
        boto3==1.34.106 \
        protobuf==4.25.3 \
        numpy==1.26.4 \
        pandas==2.2.2 \
        scikit-learn==1.4.2 \
        prophet==1.1.5 \
        pyod==1.1.3 \
        click==8.1.7 \
        waitress==3.0.0

# Utilisateur non-root
RUN groupadd -r -g 999 mlflow \
 && useradd  -r -u 999 -g 999 -m -s /bin/bash mlflow \
 && mkdir -p $MLFLOW_HOME $MLFLOW_ARTIFACTS_DESTINATION \
 && chown -R mlflow:mlflow $MLFLOW_HOME

USER 999
WORKDIR $MLFLOW_HOME

EXPOSE 5000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--default-artifact-root", "/mlflow/artifacts", \
     "--workers", "2"]
